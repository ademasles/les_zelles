BACKEND_URL=http://backend:8000
FRONTEND_URL=http://frontend:3000
HUGGINGFACE_TOKEN="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"
#OLLAMA_HOST=http://ollama:11434

# Environment
APP_ENV=local
DEBUG=false

# App
APP_TITLE=Analyse-DCE API
BACKEND_API_URL=http://localhost:8000
MAX_UPLOAD_MB=50

# Storage and Database
DATABASE_URL=sqlite+aiosqlite:///./data/analyse_dce.db
STORAGE_DIR=./data/storage
QUERIES_PATH=./queries.json
FEEDBACK_FILE=./feedback_dataset.jsonl

# Document Processing
PARSER_DEFAULT=docling
ENABLE_OCR=true
TESSERACT_LANG=fra+eng

# Vector Store and Embedding
VECTOR_STORE=faiss
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# LLM Provider
LLM_PROVIDER=ollama
LLM_MODEL=mistral
OLLAMA_BASE_URL=http://localhost:11434

# Training
TRAIN_THRESHOLD=100
CROSS_ENCODER_MODEL=dangvantuan/CrossEncoder-camembert-large
CROSS_ENCODER_OUTPUT_DIR=./models/crossencoder_finetuned

# Model Parameters
CHUNK_MAX_CHARS=3000
MAX_CONTEXT_TOKENS=3000