# Copy to .env and adjust. Never commit .env.
# Every setting is prefixed ZELLES_; see src/zelles/config.py for the full list.

# Storage
ZELLES_DATA_DIR=./data
# ZELLES_DATABASE_URL=postgresql+psycopg://zelles:zelles@localhost:5432/zelles

# LLM, as provider:model. "none" runs the free rules-only pipeline.
#   ollama:qwen3:8b | llamacpp:local | vllm:<model> | lmstudio:<model>
#   anthropic:claude-sonnet-5-5 | openai:<model> | mistral:<model> | gemini:<model> | openrouter:<model>
ZELLES_LLM_MODEL=none
# ZELLES_LLM_BASE_URL=http://localhost:11434/v1
# ZELLES_LLM_API_KEY=
ZELLES_LLM_CONCURRENCY=2
# full: LLM reads every field; gaps: only fields the rules missed, verified values only
ZELLES_LLM_MODE=full
# Seconds per LLM reply; defaults to 600 for local servers, 180 for cloud APIs.
# ZELLES_LLM_TIMEOUT_S=600
# Ollama only: context window, and whether thinking models may reason first.
# ZELLES_OLLAMA_NUM_CTX=6144
# ZELLES_OLLAMA_THINK=false

# Embeddings for hybrid search. "none" is BM25 only.
ZELLES_EMBEDDING_MODEL=none
# ZELLES_EMBEDDING_MODEL=ollama:bge-m3

# Ingestion
ZELLES_PARSER=auto
ZELLES_OCR_ENABLED=true
ZELLES_OCR_LANGUAGE=fra

# API
# ZELLES_API_KEY=change-me
ZELLES_LOG_LEVEL=INFO
ZELLES_LOG_JSON=false

# Ollama host, when it does not run on localhost (Docker compose sets this).
# OLLAMA_HOST=http://ollama:11434
